@echo off
set "MIRROR_HELPER_ROOT=%~dp0"
powershell.exe -NoProfile -Command "$r=$env:MIRROR_HELPER_ROOT; $port=43128; if($env:PREVIS_PORT){$port=[int]$env:PREVIS_PORT}; $url='http://127.0.0.1:'+$port; $ok=$false; try{$h=Invoke-RestMethod ($url+'/health') -TimeoutSec 2; $ok=$h.setup -eq $true}catch{}; if(-not $ok){& (Join-Path $r 'runtime\node.exe') (Join-Path $r 'helper.mjs') --prepare; if($LASTEXITCODE -ne 0){Write-Host 'Runtime preparation failed. Check network and start again.'; if(-not $env:MIRROR_HELPER_TEST){Read-Host 'Press Enter'}; exit 1}; $args=@(([char]34)+(Join-Path $r 'helper.mjs')+([char]34)); Start-Process -FilePath (Join-Path $r 'runtime\node.exe') -ArgumentList $args -WorkingDirectory $r -WindowStyle Hidden; for($i=0;$i -lt 120;$i++){try{$h=Invoke-RestMethod ($url+'/health') -TimeoutSec 2; if($h.setup){$ok=$true; break}}catch{}; Start-Sleep -Milliseconds 500}}; if($ok){if($env:MIRROR_HELPER_TEST){Write-Output 'HELPER_READY'}else{Start-Process ($url+'/setup')}}else{Write-Host 'Helper could not start. Close old previs service or run runtime\node.exe helper.mjs to diagnose.'; if(-not $env:MIRROR_HELPER_TEST){Read-Host 'Press Enter'}; exit 1}"
